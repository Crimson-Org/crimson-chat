// crimson-build writes each task as a .sh script for Linux and macOS in this folder, and those
// scripts run anywhere without Crimson Build.
{
	"systems": ["unix"],
	"env": {
		"PROGRAM": "crimson-chat",
		"BOUNCER": "crimson-chat-bouncer",
		"APPLICATION_ID": "io.github.CrimsonOrg.CrimsonChat",
		"VERSION": "0.1.0",
		"PREFIX": "${HOME}/.local",
		"STD": "c11",
		"WARN": "-Wall -Wextra -Wpedantic -Werror -Wno-unused-parameter",
		"OPT": "-O2 -g",
		"GTK_MINOR": "16",
		"ADWAITA_MINOR": "7",
		"PKGS": "gtk4 >= 4.${GTK_MINOR} libadwaita-1 >= 1.${ADWAITA_MINOR} libsoup-3.0 >= 3.4",
		"BOUNCER_PKGS": "gio-2.0 >= 2.74 gio-unix-2.0 sqlite3 gnutls >= 3.6.13 gdk-pixbuf-2.0",
		"DEFINES": "-D_GNU_SOURCE -DAPPLICATION_VERSION=\"${VERSION}\"",
		"VERSION_CHECKS": "-DGDK_VERSION_MIN_REQUIRED=GDK_VERSION_4_${GTK_MINOR} -DGDK_VERSION_MAX_ALLOWED=GDK_VERSION_4_${GTK_MINOR} -DADW_VERSION_MIN_REQUIRED=ADW_VERSION_1_${ADWAITA_MINOR} -DADW_VERSION_MAX_ALLOWED=ADW_VERSION_1_${ADWAITA_MINOR}",
		"INCLUDES": "-Isrc -Isubprojects/crimson-core/src",
		"HEADERS": "src/*/*.h subprojects/crimson-core/src/*/*.h subprojects/crimson-core/src/*/*/*.h",
		"LIBS": "-lm",
		"EXTRA_PROGRAMS": "build/${BOUNCER}"
	},
	"tasks": {
		"build-bouncer": {
			"description": "Build the Crimson Chat bouncer, which needs no graphical libraries",
			"steps": [
				{"needs": ["cc", "pkg-config"]},
				{"pkg": "${BOUNCER_PKGS}"},
				{"mkdir": ["build/irc", "build/bouncer"]},
				{"each": {"from": "src/irc/*.c", "to": "build/irc/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $(pkg-config --cflags \"$BOUNCER_PKGS\" | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": "src/irc/*.h"}},
				{"each": {"from": "src/bouncer/*.c", "to": "build/bouncer/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $(pkg-config --cflags \"$BOUNCER_PKGS\" | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": "src/irc/*.h src/bouncer/*.h"}},
				"cc -o build/${BOUNCER} build/irc/*.o build/bouncer/*.o $(pkg-config --libs \"$BOUNCER_PKGS\")",
				{"copy": {"from": "build/${BOUNCER}", "to": ".${BOUNCER}.new"}},
				{"move": {"from": ".${BOUNCER}.new", "to": "${BOUNCER}"}}
			]
		},
		"build": {
			"description": "Build Crimson Chat and its bouncer into the project folder",
			"depends": "build-bouncer",
			"steps": [
				{"needs": ["cc", "pkg-config", "glib-compile-resources"]},
				{"pkg": "${PKGS}"},
				{"mkdir": ["build/obj"]},
				"glib-compile-resources --sourcedir assets --target build/resources.c --generate-source assets/crimson-chat.gresource.xml",
				"glib-compile-resources --sourcedir subprojects/crimson-core/assets --target build/core-resources.c --generate-source subprojects/crimson-core/assets/crimson-core.gresource.xml",
				{"each": {"from": "src/*.c src/app/*.c src/conversation/*.c src/rooms/*.c src/session/*.c src/window/*.c subprojects/crimson-core/src/common/*/*.c", "to": "build/obj/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $VERSION_CHECKS $INCLUDES $(pkg-config --cflags \"$PKGS\" | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": "${HEADERS}"}},
				{"each": {"from": "build/resources.c build/core-resources.c", "to": "build/obj/{id}.o", "run": "cc -std=gnu11 $OPT $(pkg-config --cflags gio-2.0) -c {from} -o {to}"}},
				"cc -o build/${PROGRAM} build/obj/*.o build/irc/*.o $(pkg-config --libs \"$PKGS\") $LIBS",
				{"copy": {"from": "build/${PROGRAM}", "to": ".${PROGRAM}.new"}},
				{"move": {"from": ".${PROGRAM}.new", "to": "${PROGRAM}"}},
				{"mkdir": ["logs"]}
			]
		},
		"run": {
			"description": "Build and start Crimson Chat",
			"depends": "build",
			"steps": [
				"./${PROGRAM}"
			]
		},
		"bouncer": {
			"description": "Build and start the bouncer, which asks for an admin account on its first launch",
			"depends": "build-bouncer",
			"steps": [
				"./${BOUNCER}"
			]
		},
		"install": {
			"description": "Install Crimson Chat and its bouncer for the current user",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/install.sh"
			]
		},
		"uninstall": {
			"description": "Remove Crimson Chat and its bouncer from the current user",
			"steps": [
				"sh subprojects/crimson-core/scripts/uninstall.sh"
			]
		},
		"archive": {
			"description": "Pack Crimson Chat and its bouncer into a tar.gz archive in dist",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/package.sh"
			]
		},
		"clean": {
			"description": "Remove the build folder",
			"steps": [
				{"remove": "build"}
			]
		}
	}
}
