// Saving this file writes each task as a .sh script for Linux and macOS and a .cmd script for
// Windows in this folder, and those scripts run anywhere without Crimson Build.
{
	"env": {
		"PROGRAM": "crimson-chat",
		"BOUNCER": "crimson-chat-bouncer",
		"APPLICATION_ID": "io.github.CrimsonOrg.CrimsonChat",
		"VERSION": "0.1.0",
		"PREFIX": "${HOME}/.local",
		"STD": "c11",
		"WARN": "-Wall -Wextra -Wpedantic -Werror -Wno-unused-parameter",
		"OPT": "-O2 -g",
		"PKGS": "gtk4 libadwaita-1 libsoup-3.0",
		"BOUNCER_PKGS": "gio-2.0 gio-unix-2.0 sqlite3 gnutls",
		"DEFINES": "-D_GNU_SOURCE -DAPPLICATION_VERSION=\"${VERSION}\"",
		"INCLUDES": "-Isrc -Isubprojects/crimson-core/src",
		"EXTRA_PROGRAMS": "build/${BOUNCER}"
	},
	"tasks": {
		"build-bouncer": {
			"description": "Build the Crimson Chat bouncer, which needs no graphical libraries",
			"steps": [
				{"needs": ["cc", "pkg-config"]},
				{"pkg": ["gio-2.0 >= 2.74", "sqlite3", "gnutls >= 3.6.13"]},
				{"mkdir": ["build/irc", "build/bouncer"]},
				{"each": {"from": "src/irc/*.c", "to": "build/irc/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $(pkg-config --cflags $BOUNCER_PKGS | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": ["src/irc/*.h"]}},
				{"each": {"from": "src/bouncer/*.c", "to": "build/bouncer/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $(pkg-config --cflags $BOUNCER_PKGS | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": ["src/irc/*.h", "src/bouncer/*.h"]}},
				"cc -o build/${BOUNCER} build/irc/*.o build/bouncer/*.o $(pkg-config --libs $BOUNCER_PKGS)",
				{"copy": {"from": "build/${BOUNCER}", "to": ".${BOUNCER}.new"}},
				{"move": {"from": ".${BOUNCER}.new", "to": "${BOUNCER}"}}
			]
		},
		"build": {
			"description": "Build Crimson Chat and its bouncer into the project folder",
			"depends": "build-bouncer",
			"steps": [
				{"needs": ["cc", "pkg-config", "glib-compile-resources"]},
				{"pkg": ["gtk4 >= 4.14", "libadwaita-1 >= 1.6", "libsoup-3.0"]},
				{"mkdir": ["build/obj"]},
				"glib-compile-resources --sourcedir data --target build/resources.c --generate-source data/crimson-chat.gresource.xml",
				{"each": {"from": "src/*.c", "to": "build/obj/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $INCLUDES $(pkg-config --cflags $PKGS | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": ["src/*.h", "src/irc/*.h", "lang/*.h", "subprojects/crimson-core/src/common/*.h"]}},
				{"each": {"from": "subprojects/crimson-core/src/common/*.c", "to": "build/obj/{id}.o", "run": "cc -std=${STD} $WARN $OPT $DEFINES $INCLUDES $(pkg-config --cflags $PKGS | sed \"s/-I/-isystem /g\") -c {from} -o {to}", "also": ["subprojects/crimson-core/src/common/*.h"]}},
				"cc -std=gnu11 -O2 -g $(pkg-config --cflags gio-2.0) -c build/resources.c -o build/obj/resources.o",
				"cc -o build/${PROGRAM} build/obj/*.o build/irc/*.o $(pkg-config --libs $PKGS) -lm",
				{"copy": {"from": "build/${PROGRAM}", "to": ".${PROGRAM}.new"}},
				{"move": {"from": ".${PROGRAM}.new", "to": "${PROGRAM}"}},
				{"mkdir": ["logs"]}
			]
		},
		"run": {
			"description": "Build and start Crimson Chat",
			"depends": "build",
			"steps": [
				"./${PROGRAM}"
			]
		},
		"bouncer": {
			"description": "Build and start the bouncer, which asks for an admin account on its first launch",
			"depends": "build-bouncer",
			"steps": [
				"./${BOUNCER}"
			]
		},
		"install": {
			"description": "Install Crimson Chat and its bouncer for the current user",
			"depends": "build",
			"steps": [
				"install -Dm755 build/${PROGRAM} ${PREFIX}/bin/${PROGRAM}",
				"install -Dm755 build/${BOUNCER} ${PREFIX}/bin/${BOUNCER}",
				"mkdir -p ${PREFIX}/share/applications && for desktop in data/${APPLICATION_ID}*.desktop.in; do sed \"s|@EXEC@|${PREFIX}/bin/${PROGRAM}|\" \"$desktop\" > \"${PREFIX}/share/applications/$(basename \"$desktop\" .in)\"; done",
				"install -Dm644 data/icons/scalable/apps/${APPLICATION_ID}.svg ${PREFIX}/share/icons/hicolor/scalable/apps/${APPLICATION_ID}.svg",
				"install -Dm644 data/icons/symbolic/apps/${APPLICATION_ID}-symbolic.svg ${PREFIX}/share/icons/hicolor/symbolic/apps/${APPLICATION_ID}-symbolic.svg",
				"install -Dm644 data/${APPLICATION_ID}.metainfo.xml ${PREFIX}/share/metainfo/${APPLICATION_ID}.metainfo.xml",
				"update-desktop-database ${PREFIX}/share/applications >/dev/null 2>&1 || true",
				"gtk-update-icon-cache --quiet --ignore-theme-index ${PREFIX}/share/icons/hicolor >/dev/null 2>&1 || true"
			]
		},
		"uninstall": {
			"description": "Remove Crimson Chat and its bouncer from the current user",
			"steps": [
				{"remove": "${PREFIX}/bin/${PROGRAM}"},
				{"remove": "${PREFIX}/bin/${BOUNCER}"},
				{"remove": "${PREFIX}/share/applications/${APPLICATION_ID}.desktop"},
				{"remove": "${PREFIX}/share/icons/hicolor/scalable/apps/${APPLICATION_ID}.svg"},
				{"remove": "${PREFIX}/share/icons/hicolor/symbolic/apps/${APPLICATION_ID}-symbolic.svg"},
				{"remove": "${PREFIX}/share/metainfo/${APPLICATION_ID}.metainfo.xml"}
			]
		},
		"archive": {
			"description": "Pack Crimson Chat and its bouncer into a tar.gz archive in dist",
			"depends": "build",
			"steps": [
				"sh subprojects/crimson-core/scripts/package.sh"
			]
		},
		"clean": {
			"description": "Remove the build folder",
			"steps": [
				{"remove": "build"}
			]
		}
	}
}
